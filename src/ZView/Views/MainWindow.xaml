<Window x:Class="ZView.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:media="clr-namespace:ZeroUI.Wpf.Media;assembly=ZeroUI.Wpf.Media"
        xmlns:converters="clr-namespace:ZView.Converters"
        mc:Ignorable="d"
        Title="{Binding TitleText}"
        Height="820" Width="1300"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#11131F"
        Foreground="#F1F5F9"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Design Token Brushes -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#11131F"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#181A28"/>
        <SolidColorBrush x:Key="BgHoverBrush" Color="#262A44"/>
        <SolidColorBrush x:Key="BorderDefaultBrush" Color="#2E344E"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#818CF8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>

        <!-- Modern Compact Button Style -->
        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262A44"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E344E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#32385C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262A44"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E344E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3056"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#818CF8"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#262A44"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#32385C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#BF0F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#11131F">
        <Grid.RowDefinitions>
            <!-- Row 0: Fluent Extended Custom TitleBar -->
            <RowDefinition Height="38"/>
            <!-- Row 1: Unified Quick Actions Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Contextual Mode Sub-Toolbar (Annotation, Ruler, Watermark, Deskew) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Main Viewport Canvas (ImageViewer + Overlays) -->
            <RowDefinition Height="*"/>
            <!-- Row 4: Bottom Filmstrip Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 5: Bottom Statusbar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: EXTENDED TITLEBAR ================= -->
        <Border Grid.Row="0" Background="#141724" BorderBrush="#23273C" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Caption Buttons (Right-aligned) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="Minimize">
                        <TextBlock Text="─" FontSize="11" Margin="0,0,0,2"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                        <TextBlock Text="□" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </StackPanel>

                <!-- Left: Branding & Quick Action Pills -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="#252A42" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="ZVIEW" Foreground="#818CF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding TitleText}" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= ROW 1: PRIMARY QUICK ACTIONS TOOLBAR ================= -->
        <Border Grid.Row="1"
                Background="#181A28"
                BorderBrush="#2E344E"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                Visibility="{Binding IsFullScreen, Converter={StaticResource InvBoolToVis}}">
            <DockPanel LastChildFill="True">
                <!-- Left Section: Files, Navigation, Transformations -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- File Operations -->
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding OpenFileCommand}" ToolTip="Open Image File (Ctrl+O)">
                        <TextBlock Text="📁 Open"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding OpenFolderCommand}" ToolTip="Open Folder (Ctrl+Shift+O)">
                        <TextBlock Text="📂 Folder"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="#2E344E" Margin="6,0"/>

                    <!-- Navigation -->
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding PreviousCommand}" ToolTip="Previous Image (Left / Backspace)">
                        <TextBlock Text="◀ Prev"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding NextCommand}" ToolTip="Next Image (Right / Space)">
                        <TextBlock Text="Next ▶"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="#2E344E" Margin="6,0"/>

                    <!-- View Transformations -->
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnFitToWindow_Click" ToolTip="Fit Image to Window (Ctrl+0)">
                        <TextBlock Text="⤢ Fit"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnActualSize_Click" ToolTip="Actual 100% Size (Ctrl+1)">
                        <TextBlock Text="1:1"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnZoomIn_Click" ToolTip="Zoom In (+)">
                        <TextBlock Text="🔍+"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnZoomOut_Click" ToolTip="Zoom Out (-)">
                        <TextBlock Text="🔍-"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnRotateCW_Click" ToolTip="Rotate 90° CW (Ctrl+R)">
                        <TextBlock Text="↻ Rotate"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnFlipH_Click" ToolTip="Flip Horizontal (Ctrl+H)">
                        <TextBlock Text="⇄ Flip"/>
                    </Button>
                </StackPanel>

                <!-- Right Section: Interactive Modes, HUD Toggles & Window -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- Zoom badge -->
                    <Border Background="#1D2034" CornerRadius="4" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomPercentageText}" Foreground="#818CF8" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="#2E344E" Margin="4,0"/>

                    <!-- Specialized Interactive Modes -->
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsAnnotationMode}" ToolTip="Annotation &amp; QC Defect Markup Mode (A)">
                        <TextBlock Text="✏️ Annotate"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsMeasurementMode}" ToolTip="Precision Optical Caliper &amp; Measurement (M)">
                        <TextBlock Text="📐 Measure"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsWatermarkMode}" ToolTip="Security Watermark Overlay (W)">
                        <TextBlock Text="🏷️ Watermark"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsDeskewMode}" ToolTip="Document Deskew &amp; OCR Preprocessing (D)">
                        <TextBlock Text="📄 Deskew"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="#2E344E" Margin="6,0"/>

                    <!-- HUD Toggles -->
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsMiniMapEnabled}" ToolTip="MiniMap Navigator Radar">
                        <TextBlock Text="🗺️ Map"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsPixelGridEnabled}" ToolTip="Forensic Pixel Grid">
                        <TextBlock Text="▦ Grid"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsFilmstripVisible}" ToolTip="Toggle Filmstrip (T)">
                        <TextBlock Text="🎞️ Strip"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="#2E344E" Margin="6,0"/>

                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding CopyImageCommand}" ToolTip="Copy Image (Ctrl+C)">
                        <TextBlock Text="📋 Copy"/>
                    </Button>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsMetadataDrawerOpen}" ToolTip="EXIF Metadata Drawer (I / Alt+Enter)">
                        <TextBlock Text="ℹ️ Info"/>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding ToggleFullScreenCommand}" ToolTip="Fullscreen Mode (F11)">
                        <TextBlock Text="⛶ Full"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= ROW 2: CONTEXTUAL SUB-TOOLBARS ================= -->
        <!-- 1. Annotation Sub-Bar -->
        <Border Grid.Row="2" Background="#1F2438" BorderBrush="#2E344E" BorderThickness="0,0,0,1" Padding="12,4"
                Visibility="{Binding IsAnnotationMode, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="ANNOTATION TOOL:" FontSize="10" FontWeight="Bold" Foreground="#818CF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetToolBox_Click" ToolTip="Bounding Box">
                        <TextBlock Text="🔲 Box"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetToolArrow_Click" ToolTip="Defect Arrow">
                        <TextBlock Text="↗ Arrow"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetToolEllipse_Click" ToolTip="Ellipse Zone">
                        <TextBlock Text="⭕ Ellipse"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetToolCallout_Click" ToolTip="Text Callout">
                        <TextBlock Text="💬 Callout"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetToolBlur_Click" ToolTip="Mask Sensitive Region">
                        <TextBlock Text="🔒 Blur"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#2E344E" Margin="8,0"/>

                    <TextBlock Text="SEVERITY:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetSeverityOk_Click" Foreground="#A6E3A1">
                        <TextBlock Text="● OK"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetSeverityWarning_Click" Foreground="#F9E2AF">
                        <TextBlock Text="● Warning"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetSeverityDefect_Click" Foreground="#F38BA8">
                        <TextBlock Text="● Defect"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSetSeverityCritical_Click" Foreground="#EB4D4B">
                        <TextBlock Text="● Critical"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSaveAnnotatedImage_Click" Background="#818CF8" Foreground="#11131F" FontWeight="Bold" Padding="12,2">
                        <TextBlock Text="💾 Export Annotated Image"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Measurement Sub-Bar -->
        <Border Grid.Row="2" Background="#1F2438" BorderBrush="#2E344E" BorderThickness="0,0,0,1" Padding="12,4"
                Visibility="{Binding IsMeasurementMode, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="CALIPER MODE:" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnMeasureLinear_Click" ToolTip="2-Point Distance Caliper">
                        <TextBlock Text="📏 Distance"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnMeasureAngle_Click" ToolTip="3-Point Angle Gauge">
                        <TextBlock Text="∠ Angle"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#2E344E" Margin="8,0"/>

                    <TextBlock Text="UNIT:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnUnitMm_Click">
                        <TextBlock Text="mm"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnUnitUm_Click">
                        <TextBlock Text="μm"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnUnitPx_Click">
                        <TextBlock Text="px"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#2E344E" Margin="8,0"/>

                    <TextBlock Text="CALIBRATION (mm/px):" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding CalibrationFactor, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="22" Background="#141724" Foreground="#00E5FF" BorderBrush="#2E344E" FontSize="11" Padding="4,1" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Drag cyan caliper handles on image to inspect dimension" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Watermark Sub-Bar -->
        <Border Grid.Row="2" Background="#1F2438" BorderBrush="#2E344E" BorderThickness="0,0,0,1" Padding="12,4"
                Visibility="{Binding IsWatermarkMode, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="STAMP TEXT:" FontSize="10" FontWeight="Bold" Foreground="#F9E2AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" Width="260" Height="22" Background="#141724" Foreground="#F1F5F9" BorderBrush="#2E344E" FontSize="11" Padding="4,1" VerticalContentAlignment="Center"/>

                    <Rectangle Width="1" Height="16" Fill="#2E344E" Margin="8,0"/>

                    <TextBlock Text="OPACITY:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider Value="{Binding WatermarkOpacity}" Minimum="0.05" Maximum="1.0" SmallChange="0.05" Width="80" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnSaveWatermarkedImage_Click" Background="#F9E2AF" Foreground="#11131F" FontWeight="Bold" Padding="12,2">
                        <TextBlock Text="💾 Export Watermarked Image"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 4. Deskew Sub-Bar -->
        <Border Grid.Row="2" Background="#1F2438" BorderBrush="#2E344E" BorderThickness="0,0,0,1" Padding="12,4"
                Visibility="{Binding IsDeskewMode, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="DESKEW ROTATION:" FontSize="10" FontWeight="Bold" Foreground="#A6E3A1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider Value="{Binding DeskewAngle}" Minimum="-45.0" Maximum="45.0" Width="140" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DeskewAngle, StringFormat='{}{0:F1}°'}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11" Width="42" Margin="6,0,0,0" VerticalAlignment="Center"/>

                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnResetDeskew_Click" ToolTip="Reset Angle to 0°">
                        <TextBlock Text="↺ Reset"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#2E344E" Margin="8,0"/>

                    <CheckBox IsChecked="{Binding IsBinarizationEnabled}" Content="OCR Binarize Preview" Foreground="#F1F5F9" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnExportDeskewedImage_Click" Background="#A6E3A1" Foreground="#11131F" FontWeight="Bold" Padding="12,2">
                        <TextBlock Text="💾 Export Clean Document"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= ROW 3: MAIN VIEWPORT CANVAS ================= -->
        <Grid Grid.Row="3">
            <!-- 1. GPU Image Viewer Canvas -->
            <media:ZImageViewer x:Name="ImageViewer"
                                Source="{Binding CurrentImageSource}"
                                Zoom="{Binding CurrentZoom, Mode=TwoWay}"
                                ShowMiniMap="{Binding IsMiniMapEnabled}"
                                ShowPixelGrid="{Binding IsPixelGridEnabled}"
                                ShowLoupe="False"
                                ShowToolbar="False"
                                ShowStatusBar="False"/>

            <!-- 2. Interactive Annotation Layer -->
            <media:ZAnnotationCanvas x:Name="AnnotationLayer"
                                     CurrentTool="{Binding AnnotationTool}"
                                     CurrentSeverity="{Binding AnnotationSeverity}"
                                     Visibility="{Binding IsAnnotationMode, Converter={StaticResource BoolToVis}}"/>

            <!-- 3. Interactive Optical Measurement Caliper Layer -->
            <media:ZMeasurementRuler x:Name="MeasurementRulerLayer"
                                     Mode="{Binding MeasurementMode}"
                                     Unit="{Binding MeasurementUnit}"
                                     CalibrationFactor="{Binding CalibrationFactor}"
                                     Visibility="{Binding IsMeasurementMode, Converter={StaticResource BoolToVis}}"/>

            <!-- 4. Dynamic Watermark Overlay Layer -->
            <media:ZWatermarkOverlay x:Name="WatermarkLayer"
                                     WatermarkText="{Binding WatermarkText}"
                                     WatermarkOpacity="{Binding WatermarkOpacity}"
                                     Placement="{Binding WatermarkPlacement}"
                                     Visibility="{Binding IsWatermarkMode, Converter={StaticResource BoolToVis}}"/>

            <!-- 5. Document Deskew Overlay Layer -->
            <media:ZDocumentDeskew x:Name="DeskewLayer"
                                   Source="{Binding CurrentImageSource}"
                                   DeskewAngle="{Binding DeskewAngle}"
                                   IsBinarizationEnabled="{Binding IsBinarizationEnabled}"
                                   Threshold="{Binding BinarizationThreshold}"
                                   Visibility="{Binding IsDeskewMode, Converter={StaticResource BoolToVis}}"/>

            <!-- Placeholder Welcome Screen if No Image Loaded -->
            <Border Background="#11131F"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="36"
                    CornerRadius="12"
                    BorderBrush="#2E344E"
                    BorderThickness="1"
                    Visibility="{Binding CurrentImageSource, Converter={StaticResource InvBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="🖼️" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Zero Universe — ZView" FontSize="22" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="High-performance GPU-accelerated image workstation and inspection studio." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Button Style="{StaticResource ToolbarBtnStyle}"
                                Command="{Binding OpenFileCommand}"
                                Background="#818CF8" Foreground="#11131F"
                                FontWeight="Bold" Height="36" Padding="18,6" Margin="0,0,10,0">
                            <TextBlock Text="📁 Open Image File"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarBtnStyle}"
                                Command="{Binding OpenFolderCommand}"
                                Height="36" Padding="16,6">
                            <TextBlock Text="📂 Open Folder"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Drag &amp; drop any image, document or folder to open instantly" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Loading Spinner Indicator -->
            <Border Background="#CC11131F"
                    CornerRadius="8"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡ Loading image..." Foreground="#818CF8" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Floating OSD (On-Screen Display) Banner -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0"
                    Background="#E6181A28"
                    BorderBrush="#80818CF8"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16,6"
                    Visibility="{Binding IsOsdVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding OsdText}" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- Right Slide-In EXIF & Telemetry Drawer -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="330"
                    Background="#F2181A28"
                    BorderBrush="#2E344E"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsMetadataDrawerOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Drawer Header -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarBtnStyle}" Command="{Binding ToggleMetadataCommand}" Content="✕" Width="26" Height="26"/>
                            <TextBlock Text="EXIF &amp; METADATA" FontWeight="Bold" FontSize="13" Foreground="#818CF8" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- File Section -->
                        <TextBlock Text="FILE ATTRIBUTES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Border Background="#1D2034" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentMetadata.FileName}" FontWeight="SemiBold" Foreground="#F1F5F9" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentMetadata.FileSizeFormatted}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentMetadata.FilePath}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Image Dimensions Section -->
                        <TextBlock Text="IMAGE TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Border Background="#1D2034" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Width" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.PixelWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Height" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.PixelHeight, StringFormat='{}{0} px'}" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Aspect Ratio" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.AspectRatio}" FontWeight="SemiBold" Foreground="#818CF8"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Megapixels" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.Megapixels}" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Bit Depth" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.BitsPerPixel, StringFormat='{}{0} bpp'}" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Density" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.DpiX, StringFormat='{}{0} DPI'}" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Camera EXIF Section -->
                        <TextBlock Text="CAMERA EXIF TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <Border Background="#1D2034" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Camera Model" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.CameraModel, FallbackValue='N/A'}" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Lens" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CurrentMetadata.LensModel, FallbackValue='N/A'}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ISO" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentMetadata.Iso, FallbackValue='-'}" FontWeight="SemiBold" Foreground="#A6E3A1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Aperture" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentMetadata.FNumber, FallbackValue='-'}" FontWeight="SemiBold" Foreground="#F9E2AF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Shutter" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentMetadata.ExposureTime, FallbackValue='-'}" FontWeight="SemiBold" Foreground="#818CF8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= ROW 4: BOTTOM FILMSTRIP ================= -->
        <Border Grid.Row="4"
                Background="#141724"
                BorderBrush="#2E344E"
                BorderThickness="0,1,0,0"
                Height="96"
                Visibility="{Binding IsFilmstripVisible, Converter={StaticResource BoolToVis}}">
            <ListBox x:Name="FilmstripList"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding CurrentItem, Mode=OneWay}"
                     SelectionChanged="FilmstripList_SelectionChanged"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="3,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="itemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#4F46E5"/>
                                            <Setter TargetName="itemBorder" Property="Background" Value="#1F2438"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#818CF8"/>
                                            <Setter TargetName="itemBorder" Property="Background" Value="#252A42"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="78" Height="78">
                            <Border Background="#1D2034" CornerRadius="4">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                            </Border>
                            <Border Background="#CC11131F" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Padding="4,2">
                                <TextBlock Text="{Binding FileName}" FontSize="9" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ================= ROW 5: BOTTOM STATUSBAR ================= -->
        <Border Grid.Row="5"
                Background="#181A28"
                BorderBrush="#2E344E"
                BorderThickness="0,1,0,0"
                Padding="12,4"
                Visibility="{Binding IsFullScreen, Converter={StaticResource InvBoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Shortcuts: Left/Right (Nav) · Ctrl+Scroll (Zoom) · A (Annotate) · M (Measure) · W (Watermark) · D (Deskew) · F11 (Full)"
                               FontSize="11" Foreground="#64748B"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
