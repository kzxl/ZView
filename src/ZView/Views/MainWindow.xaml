<Window x:Class="ZView.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:zui="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf.Editors"
        xmlns:zuib="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf.Common"
        xmlns:loc="clr-namespace:ZeroUI.Wpf.Localization;assembly=ZeroUI.Wpf.Common"
        xmlns:media="clr-namespace:ZeroUI.Wpf.Media;assembly=ZeroUI.Wpf.Media"
        xmlns:converters="clr-namespace:ZView.Converters"
        mc:Ignorable="d"
        Title="{loc:Loc Key=ZView.Title, Default='ZView — Enterprise Image Workstation'}"
        Height="840" Width="1320"
        MinHeight="500" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ZeroUI.BgPrimary}"
        Foreground="{DynamicResource ZeroUI.TextPrimary}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:InverseNullToVisibilityConverter x:Key="InvNullToVis"/>

        <!-- Dynamic Theme Adaptive Toolbar Button Style -->
        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ZeroUI.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ZeroUI.BgHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ZeroUI.BorderDefault}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ZeroUI.BgActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ZeroUI.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ZeroUI.BgHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ZeroUI.BorderDefault}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ZeroUI.SelectionBackground}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ZeroUI.PrimaryAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ZeroUI.TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ZeroUI.BgHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ZeroUI.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ZeroUI.BgActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#BF0F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ZeroUI.BgPrimary}">
        <Grid.RowDefinitions>
            <!-- Row 0: Fluent Extended Custom TitleBar -->
            <RowDefinition Height="38"/>
            <!-- Row 1: Unified High-Performance Viewer Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Main Viewport Canvas (GPU Accelerated Viewer) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Bottom Filmstrip Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Bottom Statusbar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: EXTENDED TITLEBAR ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource ZeroUI.BgCard}"
                BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <!-- GitHub Update Notification Pill Badge -->
                    <Button Style="{StaticResource CaptionBtnStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenUpdateDialogCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                            ToolTip="Có bản cập nhật mới từ GitHub! Bấm để xem chi tiết"
                            Width="Auto" Padding="6,2">
                        <Border Background="#F59E0B" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{Binding UpdateBadgeText}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </Button>

                    <!-- Shortcut Help Button -->
                    <Button Style="{StaticResource CaptionBtnStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ToggleShortcutDialogCommand}"
                            ToolTip="{loc:Loc Key=ZView.Nav.Help, Default='Phím tắt &amp; Trợ giúp (?)'}">
                        <TextBlock Text="❓" FontSize="11"/>
                    </Button>

                    <!-- Settings Options Button -->
                    <Button Style="{StaticResource CaptionBtnStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="{loc:Loc Key=ZView.Nav.Settings, Default='Cài đặt hiển thị (S)'}">
                        <TextBlock Text="⚙️" FontSize="12"/>
                    </Button>

                    <!-- Language Switcher Quick Pill -->
                    <Button Style="{StaticResource CaptionBtnStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ToggleLanguageCommand}"
                            ToolTip="{loc:Loc Key=ZView.Nav.Language, Default='Chuyển ngôn ngữ (L)'}">
                        <TextBlock FontWeight="Bold" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🇻🇳 VI"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVietnamese}" Value="False">
                                            <Setter Property="Text" Value="🇺🇸 EN"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Theme Switcher Quick Pill (Light / Dark) -->
                    <Button Style="{StaticResource CaptionBtnStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{loc:Loc Key=ZView.Nav.Theme, Default='Chuyển giao diện Sáng/Tối (T)'}">
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="☀️"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                            <Setter Property="Text" Value="🌙"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Skin Studio Palette -->
                    <Button Style="{StaticResource CaptionBtnStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenSkinStudioCommand}"
                            ToolTip="{loc:Loc Key=ZView.Nav.SkinStudio, Default='Bảng màu Skin Studio'}">
                        <TextBlock Text="🎨" FontSize="11"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource ZeroUI.BorderSubtle}" Margin="2,0"/>

                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="Minimize">
                        <TextBlock Text="─" FontSize="11" Margin="0,0,0,2"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                        <TextBlock Text="□" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11"/>
                    </Button>
                </StackPanel>

                <!-- Left: Branding & Dynamic Image Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="{DynamicResource ZeroUI.PrimaryAccent}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="{loc:Loc Key=ZView.Brand, Default='ZVIEW'}" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding TitleText}" Foreground="{DynamicResource ZeroUI.TextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= ROW 1: PRIMARY VIEWER TOOLBAR ================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource ZeroUI.BgCard}"
                BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                Visibility="{Binding IsFullScreen, Converter={StaticResource InvBoolToVis}}">
            <DockPanel LastChildFill="True">
                <!-- Left Section: File Operations & Navigation -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- File Operations -->
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding OpenFileCommand}" ToolTip="{loc:Loc Key=ZView.Nav.Open, Default='Mở tệp ảnh (Ctrl+O)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 "/>
                            <TextBlock Text="{loc:Loc Key=ZView.Nav.OpenBtn, Default='Mở ảnh'}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding OpenFolderCommand}" ToolTip="{loc:Loc Key=ZView.Nav.OpenFolder, Default='Mở thư mục ảnh (Ctrl+Shift+O)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂 "/>
                            <TextBlock Text="{loc:Loc Key=ZView.Nav.OpenFolderBtn, Default='Thư mục'}"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ZeroUI.BorderDefault}" Margin="6,0"/>

                    <!-- Navigation -->
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding PreviousCommand}" ToolTip="{loc:Loc Key=ZView.Nav.Prev, Default='Ảnh trước (← / Backspace)'}">
                        <TextBlock Text="◀"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding NextCommand}" ToolTip="{loc:Loc Key=ZView.Nav.Next, Default='Ảnh sau (→ / Space)'}">
                        <TextBlock Text="▶"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ZeroUI.BorderDefault}" Margin="6,0"/>

                    <!-- View Transformations -->
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnFitToWindow_Click" ToolTip="{loc:Loc Key=ZView.Nav.Fit, Default='Vừa khung (F / Ctrl+0)'}">
                        <TextBlock Text="⤢"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnActualSize_Click" ToolTip="{loc:Loc Key=ZView.Nav.ActualSize, Default='Kích thước gốc 100% (1 / Ctrl+1)'}">
                        <TextBlock Text="1:1"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnZoomIn_Click" ToolTip="Phóng to (+)">
                        <TextBlock Text="🔍+"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnZoomOut_Click" ToolTip="Thu nhỏ (-)">
                        <TextBlock Text="🔍-"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnRotateCW_Click" ToolTip="{loc:Loc Key=ZView.Nav.RotateRight, Default='Xoay phải 90° (R)'}">
                        <TextBlock Text="↻"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Click="BtnFlipH_Click" ToolTip="{loc:Loc Key=ZView.Nav.FlipH, Default='Lật ngang (H)'}">
                        <TextBlock Text="⇄"/>
                    </Button>
                </StackPanel>

                <!-- Right Section: Zoom Indicator, HUD Controls & Drawers -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- Zoom badge -->
                    <Border Background="{DynamicResource ZeroUI.BgInput}" BorderBrush="{DynamicResource ZeroUI.BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomPercentageText}" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ZeroUI.BorderDefault}" Margin="4,0"/>

                    <!-- HUD Toggles -->
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsMiniMapEnabled}" ToolTip="{loc:Loc Key=ZView.Settings.MiniMap, Default='Radar MiniMap'}">
                        <TextBlock Text="🗺️"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsPixelGridEnabled}" ToolTip="{loc:Loc Key=ZView.Settings.PixelGrid, Default='Lưới điểm ảnh (Grid)'}">
                        <TextBlock Text="▦"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsLoupeEnabled}" ToolTip="Kính lúp nổi theo chuột (Z)">
                        <TextBlock Text="🔍"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsFilterVisible}" ToolTip="Tìm kiếm &amp; Lọc ảnh (/ / Ctrl+F)">
                        <TextBlock Text="🔎"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsFilmstripVisible}" ToolTip="{loc:Loc Key=ZView.Nav.Filmstrip, Default='Bật/Tắt dải phim (B)'}">
                        <TextBlock Text="🎞️"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ZeroUI.BorderDefault}" Margin="6,0"/>

                    <!-- Actions & Drawers -->
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding PrintImageCommand}" ToolTip="{loc:Loc Key=ZView.Nav.Print, Default='In ảnh trực tiếp (Ctrl+P)'}">
                        <TextBlock Text="🖨️"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding CopyImageCommand}" ToolTip="Sao chép ảnh vào Clipboard (Ctrl+C)">
                        <TextBlock Text="📋"/>
                    </Button>

                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsMetadataDrawerOpen}" ToolTip="{loc:Loc Key=ZView.Nav.Info, Default='Thông số &amp; EXIF (I)'}">
                        <TextBlock Text="ℹ️"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" IsChecked="{Binding IsSettingsDrawerOpen}" ToolTip="{loc:Loc Key=ZView.Nav.Settings, Default='Cài đặt hiển thị (S)'}">
                        <TextBlock Text="⚙️"/>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarBtnStyle}" Command="{Binding ToggleFullScreenCommand}" ToolTip="{loc:Loc Key=ZView.Nav.Fullscreen, Default='Toàn màn hình (F11)'}">
                        <TextBlock Text="⛶"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= ROW 2: MAIN VIEWPORT CANVAS ================= -->
        <Grid Grid.Row="2">
            <!-- 1. Ultra-High Performance GPU Image Viewer Canvas -->
            <media:ZImageViewer x:Name="ImageViewer"
                                Source="{Binding CurrentImageSource}"
                                Zoom="{Binding CurrentZoom, Mode=TwoWay}"
                                ShowMiniMap="{Binding IsMiniMapEnabled}"
                                ShowPixelGrid="{Binding IsPixelGridEnabled}"
                                ShowLoupe="{Binding IsLoupeEnabled}"
                                ShowToolbar="False"
                                ShowStatusBar="False"/>

            <!-- 2. Placeholder Welcome Screen if No Image Loaded (Auto-hides on image load) -->
            <Border Background="{DynamicResource ZeroUI.BgPrimary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="36,28"
                    CornerRadius="12"
                    BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                    BorderThickness="1"
                    Visibility="{Binding CurrentImageSource, Converter={StaticResource InvNullToVis}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="🖼️" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="{loc:Loc Key=ZView.Title, Default='ZView — Trạm Quan Sát &amp; Phân Tích Ảnh Chuyên Sâu'}" 
                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextPrimary}" 
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc Key=ZView.Empty.DragDrop, Default='Kéo thả ảnh hoặc thư mục vào đây để duyệt'}" 
                               FontSize="13" Foreground="{DynamicResource ZeroUI.TextSecondary}" 
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <zuib:ZButton Variant="Primary"
                                     Command="{Binding OpenFileCommand}"
                                     Height="36" Padding="18,6" Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc Key=ZView.Empty.BrowseButton, Default='📁 Chọn tệp ảnh...'}"/>
                        </zuib:ZButton>
                        <zuib:ZButton Variant="Secondary"
                                     Command="{Binding OpenFolderCommand}"
                                     Height="36" Padding="16,6">
                            <TextBlock Text="{loc:Loc Key=ZView.Nav.OpenFolder, Default='📂 Mở thư mục...'}"/>
                        </zuib:ZButton>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc Key=ZView.Empty.SupportedFormats, Default='Hỗ trợ chuẩn 30+ định dạng: PNG, JPG, WEBP, AVIF, HEIC, TIFF, BMP, ICO, TGA, PSD, SVG, RAW/DNG...'}" 
                               FontSize="11" Foreground="{DynamicResource ZeroUI.TextMuted}" 
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="16" Margin="0,0,0,14"/>

                    <!-- Recent Files History Section -->
                    <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="8" Padding="14,10"
                            Visibility="{Binding HasRecentItems, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=ZView.Empty.RecentFiles, Default='TỆP &amp; THƯ MỤC MỞ GẦN ĐÂY'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolbarBtnStyle}" 
                                                Command="{Binding DataContext.OpenRecentItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left"
                                                Height="26" Margin="0,1" Padding="6,2">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource ZeroUI.TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Loading Spinner Indicator -->
            <Border Background="{DynamicResource ZeroUI.BgCard}"
                    BorderBrush="{DynamicResource ZeroUI.PrimaryAccent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Key=ZView.Status.Loading, Default='⚡ Đang nạp ảnh...'}" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Floating OSD (On-Screen Display) Banner -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0"
                    Background="{DynamicResource ZeroUI.BgCard}"
                    BorderBrush="{DynamicResource ZeroUI.PrimaryAccent}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16,6"
                    Visibility="{Binding IsOsdVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding OsdText}" Foreground="{DynamicResource ZeroUI.TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- Right Slide-In EXIF & Telemetry Drawer -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="330"
                    Background="{DynamicResource ZeroUI.BgCard}"
                    BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsMetadataDrawerOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Drawer Header -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarBtnStyle}" Command="{Binding ToggleMetadataCommand}" Content="✕" Width="26" Height="26"/>
                            <TextBlock Text="{loc:Loc Key=ZView.Drawer.Title, Default='SIÊU DỮ LIỆU &amp; EXIF'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- File Section -->
                        <TextBlock Text="{loc:Loc Key=ZView.Drawer.BasicInfo, Default='THÔNG TIN TỆP CƠ BẢN'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentMetadata.FileName}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentMetadata.FileSizeFormatted}" FontSize="11" Foreground="{DynamicResource ZeroUI.TextSecondary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentMetadata.FilePath}" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Image Dimensions Section -->
                        <TextBlock Text="{loc:Loc Key=ZView.Status.Dimensions, Default='KÍCH THƯỚC &amp; ĐỘ PHÂN GIẢI'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Width" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.PixelWidth, StringFormat='{}{0} px'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Height" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.PixelHeight, StringFormat='{}{0} px'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Aspect Ratio" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.AspectRatio}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Megapixels" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.Megapixels}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Bit Depth" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.BitsPerPixel, StringFormat='{}{0} bpp'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Density" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.DpiX, StringFormat='{}{0} DPI'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Camera EXIF Section -->
                        <TextBlock Text="{loc:Loc Key=ZView.Drawer.ExifData, Default='THÔNG SỐ MÁY ẢNH (EXIF)'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc Key=ZView.Drawer.Camera, Default='Thiết bị:'}" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.CameraModel, FallbackValue='N/A'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc Key=ZView.Drawer.Lens, Default='Ống kính:'}" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.LensModel, FallbackValue='N/A'}" FontSize="11" Foreground="{DynamicResource ZeroUI.TextSecondary}"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ISO" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                        <TextBlock Text="{Binding CurrentMetadata.Iso, FallbackValue='-'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.Success}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Aperture" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                        <TextBlock Text="{Binding CurrentMetadata.FNumber, FallbackValue='-'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.Warning}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Shutter" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                        <TextBlock Text="{Binding CurrentMetadata.ExposureTime, FallbackValue='-'}" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Engine & Hardware Telemetry Section -->
                        <TextBlock Text="HIỆU NĂNG &amp; ENGINE ZERO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="I/O Kernel:" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.DecodeEngineInfo}" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.Success}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Decode Latency:" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="{Binding CurrentMetadata.DecodeLatencyMs, StringFormat='{}{0} ms'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Color Inspector:" FontSize="10" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                                    <TextBlock Text="ZeroPrimitives FastHex + Span" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextSecondary}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>


            <!-- Right Slide-In Settings & Display Options Drawer -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="320"
                    Background="{DynamicResource ZeroUI.BgCard}"
                    BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsSettingsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Header -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarBtnStyle}" Command="{Binding ToggleSettingsCommand}" Content="✕" Width="26" Height="26"/>
                            <TextBlock Text="{loc:Loc Key=ZView.Settings.Title, Default='CÀI ĐẶT &amp; TÙY CHỌN'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Filmstrip Group -->
                        <TextBlock Text="{loc:Loc Key=ZView.Settings.FilmstripGroup, Default='DẢI PHIM THUMBNAIL PHÍA DƯỚI'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <CheckBox IsChecked="{Binding IsFilmstripVisible}" Content="{loc:Loc Key=ZView.Settings.ShowFilmstrip, Default='Hiển thị thanh dải phim (B)'}" Foreground="{DynamicResource ZeroUI.TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <CheckBox IsChecked="{Binding ShowThumbnailFileName}" Content="{loc:Loc Key=ZView.Settings.ShowFileName, Default='Hiển thị tên tệp dưới ảnh'}" Foreground="{DynamicResource ZeroUI.TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Margin="0,4,0,0">
                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding ThumbnailCardSize, StringFormat='{}{0:F0} px'}" DockPanel.Dock="Right" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{loc:Loc Key=ZView.Settings.ThumbnailSize, Default='Kích thước thẻ:'}" FontSize="11" Foreground="{DynamicResource ZeroUI.TextSecondary}"/>
                                    </DockPanel>
                                    <Slider Value="{Binding ThumbnailCardSize}" Minimum="48.0" Maximum="140.0" SmallChange="4.0" LargeChange="16.0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- HUD Group -->
                        <TextBlock Text="{loc:Loc Key=ZView.Settings.HudGroup, Default='CÔNG CỤ HỖ TRỢ TRỰC QUAN (HUD)'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <CheckBox IsChecked="{Binding IsMiniMapEnabled}" Content="{loc:Loc Key=ZView.Settings.MiniMap, Default='Radar MiniMap'}" Foreground="{DynamicResource ZeroUI.TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <CheckBox IsChecked="{Binding IsPixelGridEnabled}" Content="{loc:Loc Key=ZView.Settings.PixelGrid, Default='Lưới điểm ảnh (Grid)'}" Foreground="{DynamicResource ZeroUI.TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= ROW 3: BOTTOM FILMSTRIP ================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource ZeroUI.BgCard}"
                BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                BorderThickness="0,1,0,0"
                Height="{Binding ThumbnailCardSize, ConverterParameter=22, Converter={x:Null}}"
                MinHeight="64"
                Visibility="{Binding IsFilmstripVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <!-- Search & Quick Filter Floating Bar -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource ZeroUI.BgInput}" Padding="8,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                        Visibility="{Binding IsFilterVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarBtnStyle}" Command="{Binding ToggleFilterCommand}" Content="✕" Width="20" Height="20" Margin="4,0,0,0"/>
                        <TextBlock Text="🔎" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ZeroUI.TextPrimary}"
                                 FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </DockPanel>
                </Border>

                <ListBox x:Name="FilmstripList"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding CurrentItem, Mode=OneWay}"
                         SelectionChanged="FilmstripList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="3"/>
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ZeroUI.BgHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ZeroUI.SelectionBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding DataContext.ThumbnailCardSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Height="{Binding DataContext.ThumbnailCardSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <!-- Background Card & Thumbnail -->
                                <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="4">
                                    <Grid>
                                        <!-- Fallback Loading Icon -->
                                        <TextBlock Text="🖼️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"
                                                   Visibility="{Binding Thumbnail, Converter={StaticResource InvNullToVis}}"/>
                                        <!-- Real Loaded Thumbnail -->
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"
                                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}"/>
                                    </Grid>
                                </Border>

                                <!-- Filename Badge -->
                                <Border Background="{DynamicResource ZeroUI.BgCard}"
                                        Opacity="0.9"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="0,0,4,4"
                                        Padding="4,2"
                                        Visibility="{Binding DataContext.ShowThumbnailFileName, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding FileName}" FontSize="9" Foreground="{DynamicResource ZeroUI.TextSecondary}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= ROW 4: BOTTOM STATUSBAR ================= -->
        <Border Grid.Row="4"
                Background="{DynamicResource ZeroUI.BgCard}"
                BorderBrush="{DynamicResource ZeroUI.BorderDefault}"
                BorderThickness="0,1,0,0"
                Padding="12,4"
                Visibility="{Binding IsFullScreen, Converter={StaticResource InvBoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="← / → (Nav) · Ctrl+P (Print) · F (Fit) · 1 (1:1) · R/L (Rotate) · Z (Loupe) · B (Filmstrip) · I (EXIF) · S (Settings) · ? (Help)"
                               FontSize="11" Foreground="{DynamicResource ZeroUI.TextMuted}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource ZeroUI.TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ================= DIALOG OVERLAYS ================= -->

        <!-- 1. GitHub Update Dialog Modal Overlay -->
        <Border Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsUpdateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource ZeroUI.BgCard}" BorderBrush="{DynamicResource ZeroUI.PrimaryAccent}" BorderThickness="1.5" CornerRadius="12"
                    Width="480" MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarBtnStyle}" Command="{Binding CloseUpdateDialogCommand}" Content="✕" Width="26" Height="26"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀 " FontSize="18"/>
                            <TextBlock Text="BẢN CẬP NHẬT MỚI TỪ GITHUB" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <zuib:ZButton Variant="Secondary" Command="{Binding CloseUpdateDialogCommand}" Content="Đóng" Margin="0,0,10,0" Height="32" Padding="14,4"/>
                        <zuib:ZButton Variant="Primary" Click="BtnDownloadUpdate_Click" Content="Tải &amp; Cập nhật qua ZUpdate" Height="32" Padding="16,4"/>
                    </StackPanel>

                    <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Phiên bản mới:" FontWeight="SemiBold" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                    <TextBlock Text="{Binding AvailableUpdate.LatestVersion}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.Success}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Tiêu đề Release:" FontSize="11" Foreground="{DynamicResource ZeroUI.TextSecondary}"/>
                                    <TextBlock Text="{Binding AvailableUpdate.ReleaseTitle}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </DockPanel>
                                <TextBlock Text="Ghi chú phát hành (Changelog):" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.TextMuted}" Margin="0,6,0,4"/>
                                <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes}" FontSize="11" Foreground="{DynamicResource ZeroUI.TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

        <!-- 2. Shortcut Cheat Sheet Modal Overlay -->
        <Border Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsShortcutDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource ZeroUI.BgCard}" BorderBrush="{DynamicResource ZeroUI.BorderDefault}" BorderThickness="1.5" CornerRadius="12"
                    Width="560" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarBtnStyle}" Command="{Binding ToggleShortcutDialogCommand}" Content="✕" Width="26" Height="26"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⌨️ " FontSize="18"/>
                            <TextBlock Text="SƠ ĐỒ PHÍM TẮT THAO TÁC (CHEAT SHEET)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ZeroUI.PrimaryAccent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <zuib:ZButton Variant="Primary" Command="{Binding ToggleShortcutDialogCommand}" Content="Đã hiểu" Height="32" Padding="20,4"/>
                    </StackPanel>

                    <Border Background="{DynamicResource ZeroUI.BgInput}" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="← / PageUp / Back" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Ảnh liền trước" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="→ / PageDown / Space" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Ảnh tiếp theo" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="F / Ctrl+0" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Vừa khung nhìn (Fit to window)" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="1 / Ctrl+1" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Kích thước gốc 100% (1:1 Actual Size)" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="R / L" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Xoay ảnh 90° Phải / Trái" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Z" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Bật / Tắt kính lúp nổi (Loupe HUD)" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Ctrl + F" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Tìm kiếm &amp; Lọc nhanh trên dải phim" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Ctrl + P" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="In ảnh trực tiếp (Print Dialog)" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="I / S / B" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Bật/Tắt Siêu dữ liệu / Cài đặt / Dải phim" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="F11" FontWeight="Bold" Foreground="{DynamicResource ZeroUI.PrimaryAccent}"/>
                                    <TextBlock Grid.Column="1" Text="Chế độ toàn màn hình (Fullscreen)" Foreground="{DynamicResource ZeroUI.TextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
